    <!--  Sử dụng:                                                 -->
    <!--    - background_*: nền app / màn                          -->
    <!--    - surface_*: card/panel; border_*: viền/divider        -->
    <!--    - ink_*: tiêu đề; text_body_*: nội dung dài            -->
    <!--    - chip_*: badge/filter; *_light là màu riêng cho Light -->
    <!-- ========================================================= -->
    <color name="background_light">#F7FAF9</color>
    <color name="surface_light">#FFFFFF</color>
    <color name="surface_muted_light">#F7FAF9</color>
    <color name="border_light">#E6F0EE</color>
    <color name="ink_light">#0F766E</color>
    <color name="text_body_light">#2B3A38</color>
    <color name="primary_300_light">#5EEAD4</color>
    <color name="accent_peach_light">#FFCDBE</color>
    <color name="chip_bg_light">#FFFFFF</color>
    <color name="chip_selected_bg_light">#14B8A6</color>
    <color name="chip_selected_text_light">#FFFFFF</color>
    <color name="gradient_primary_start_light">#5EEAD4</color>
    <color name="gradient_primary_end_light">#14B8A6</color>
    <color name="gradient_accent_start_light">#FFCDBE</color>
    <color name="gradient_accent_end_light">#A78BFA</color>

