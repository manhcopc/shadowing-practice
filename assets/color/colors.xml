<resources>

    <!-- ========================================================= -->
    <!--  SHARED / GLOBAL (dùng cho cả Light & Dark)               -->
    <!--  Dùng khi bạn muốn cùng một màu ở cả hai mode.            -->
    <!--  Gợi ý:                                                   -->
    <!--    - Màu thương hiệu (primary/secondary)                  -->
    <!--    - Màu trạng thái (success/warning/error)               -->
    <!--    - Màu overlay chữ/icon trên nền primary: on_primary    -->
    <!--    - Màu gradient mặc định: gradient_*                     -->
    <!-- ========================================================= -->

    <color name="basic_dark">#000000</color>
    <color name="basic_light">#FFFFFF</color>
    <color name="primary">#14B8A6</color>
    <color name="material_primary" type="material">#14B8A6</color>
    <color name="secondary">#A78BFA</color>
    <color name="material_secondary" type="material">#A78BFA</color>
    <color name="neutral">#E6F0EE</color>
    <color name="material_neutral" type="material">#E6F0EE</color>
    <color name="success">#16A34A</color>
    <color name="warning">#F59E0B</color>
    <color name="error">#EF4444</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="gradient_primary_start">#5EEAD4</color>
    <color name="gradient_primary_end">#14B8A6</color>
    <color name="gradient_accent_start">#FFCDBE</color>
    <color name="gradient_accent_end">#A78BFA</color>

    <!-- ========================================================= -->
    <!--  LIGHT MODE ONLY                                          -->
    <!--  Map trong theme Light (values/themes.xml):               -->
    <!--    <item name="android:colorBackground">@color/background_light</item>   -->
